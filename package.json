{
  "name": "aholo-lux3d",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build:core": "npm run build -w @aholo/contracts && npm run build -w @aholo/domain",
    "build": "npm run build:core && npm run build -w @aholo/api && npm run build -w @aholo/worker && npm run build -w @aholo/web",
    "local:setup": "npm run build:core && node scripts/local-db.mjs setup && npm run db:migrate && npm run seed:furniture",
    "db:start": "node scripts/local-db.mjs start",
    "db:stop": "node scripts/local-db.mjs stop",
    "db:migrate": "node scripts/migrate.mjs",
    "seed:admin": "node scripts/seed-admin.mjs",
    "dev": "npm run build:core && node scripts/dev.mjs",
    "start": "node apps/api/dist/index.js",
    "worker": "node apps/worker/dist/index.js",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node --test tests/*.integration.mjs",
    "test:e2e": "node scripts/smoke.mjs",
    "backup": "node scripts/backup.mjs",
    "restore:check": "node scripts/restore-check.mjs",
    "probe:lux3d": "node scripts/lux3d-probe.mjs",
    "probe:upload:block": "node scripts/lux3d-block-probe.mjs",
    "test:t04": "node scripts/t04-browser.mjs",
    "test:t04:input": "node scripts/t04-browser.mjs --input-only",
    "test:t10": "node scripts/t10-game-browser.mjs",
    "test:t08": "node scripts/t08-browser.mjs",
    "demo:t08": "node scripts/t08-main-demo.mjs",
    "seed:furniture": "node scripts/seed-furniture.mjs",
    "build:furniture": "node scripts/build-furniture.mjs",
    "build:characters": "node scripts/build-characters.mjs && node scripts/render-character-thumbs.mjs",
    "test:t15": "node scripts/t15-third-person-browser.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.4"
  }
}
