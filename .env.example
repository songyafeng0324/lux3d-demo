# Run npm run local:setup to create private local config without overwriting it.
DATA_DIR=
DATABASE_URL=
API_HOST=127.0.0.1
API_PORT=3001
PUBLIC_ORIGIN=http://localhost:5173
# Server only: the reverse proxy in front of the API (e.g. loopback for Nginx on the same host). Leave empty locally.
TRUST_PROXY=
LUX3D_REGION=cn
LUX3D_CN_API_KEY=
SESSION_SECRET=
APP_DATA_KEY=

# Optional server-only private credential file
LUX3D_CREDENTIALS_FILE=
